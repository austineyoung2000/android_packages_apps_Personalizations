<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:lineage="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/credential_colors_title">
    <Preference android:key="credential_status" android:selectable="false" />
    <PreferenceCategory android:key="credential_pin_options" android:title="@string/credential_pin_category">
        <ListPreference
            android:key="rising_pin_effect" android:title="@string/credential_pin_style"
            android:entries="@array/credential_pin_effect_entries" android:entryValues="@array/credential_pin_effect_values"
            android:defaultValue="0" android:summary="%s" lineage:position="top" android:persistent="false" />
        <com.android.settings.preferences.SystemSettingListPreference
            android:key="rising_pin_shape" android:title="@string/credential_pin_shape"
            android:entries="@array/credential_pin_shape_entries" android:entryValues="@array/credential_pin_shape_values"
            android:defaultValue="0" android:summary="%s" />
        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="rising_pin_first_color" android:title="@string/credential_pin_first" android:defaultValue="0xff6200ee" />
        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="rising_pin_second_color" android:title="@string/credential_pin_second" android:defaultValue="0xff0000ff" />
        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="rising_pin_digit_color" android:title="@string/credential_pin_digit" android:defaultValue="0xffffffff" />
        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="rising_pin_glow_intensity" android:title="@string/neon_glow_intensity_title"
            android:defaultValue="60" android:max="100" settings:min="0" settings:interval="1" settings:units="%" lineage:position="bottom" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="rising_pin_neon_transparency"
            android:title="@string/qs_neon_transparency_title"
            android:summary="@string/qs_neon_transparency_summary"
            android:defaultValue="78" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%" />
    </PreferenceCategory>
    <PreferenceCategory android:key="credential_pattern_options" android:title="@string/credential_pattern_category">
        <com.android.settings.preferences.SystemSettingListPreference
            android:key="rising_pattern_shape" android:title="@string/credential_pattern_shape"
            android:entries="@array/credential_pin_shape_entries" android:entryValues="@array/credential_pin_shape_values"
            android:defaultValue="0" android:summary="%s" />
        <ListPreference
            android:key="rising_pattern_effect" android:title="@string/credential_pattern_style"
            android:entries="@array/credential_pin_effect_entries" android:entryValues="@array/credential_pin_effect_values"
            android:defaultValue="0" android:summary="%s" android:persistent="false" />
        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="rising_pattern_first_color" android:title="@string/credential_pattern_first" android:defaultValue="0xff6200ee" />
        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="rising_pattern_second_color" android:title="@string/credential_pattern_second" android:defaultValue="0xff0000ff" />
        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="rising_pattern_glow_intensity" android:title="@string/neon_glow_intensity_title"
            android:defaultValue="60" android:max="100" settings:min="0" settings:interval="1" settings:units="%" lineage:position="bottom" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="rising_pattern_neon_transparency"
            android:title="@string/qs_neon_transparency_title"
            android:summary="@string/qs_neon_transparency_summary"
            android:defaultValue="81" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%" />
    </PreferenceCategory>
    <PreferenceCategory android:key="credential_knock_options" android:title="@string/credential_knock_category">
        <com.android.settings.preferences.SystemSettingListPreference
            android:key="rising_knock_effect" android:title="@string/credential_knock_effect"
            android:entries="@array/credential_pin_effect_entries" android:entryValues="@array/credential_pin_effect_values"
            android:defaultValue="0" android:summary="%s" lineage:position="top" />
        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="rising_knock_first_color" android:title="@string/credential_knock_first" android:defaultValue="0xff6200ee" />
        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="rising_knock_second_color" android:title="@string/credential_knock_second" android:defaultValue="0xff0000ff" />
        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="rising_knock_glow_intensity" android:title="@string/neon_glow_intensity_title"
            android:defaultValue="60" android:max="100" settings:min="0" settings:interval="1" settings:units="%" lineage:position="bottom" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="rising_knock_neon_transparency"
            android:title="@string/qs_neon_transparency_title"
            android:summary="@string/qs_neon_transparency_summary"
            android:defaultValue="84" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%" />
    </PreferenceCategory>
    <PreferenceCategory android:key="credential_password_options" android:title="@string/credential_password_category">
        <ListPreference
            android:key="rising_password_effect" android:title="@string/credential_password_style"
            android:entries="@array/credential_pin_effect_entries" android:entryValues="@array/credential_pin_effect_values"
            android:defaultValue="0" android:summary="%s" lineage:position="top" android:persistent="false" />
        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="rising_password_first_color" android:title="@string/credential_password_first" android:defaultValue="0xff6200ee" />
        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="rising_password_second_color" android:title="@string/credential_password_second" android:defaultValue="0xff0000ff" />
        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="rising_password_glow_intensity" android:title="@string/neon_glow_intensity_title"
            android:defaultValue="60" android:max="100" settings:min="0" settings:interval="1" settings:units="%" lineage:position="bottom" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="rising_password_neon_transparency"
            android:title="@string/qs_neon_transparency_title"
            android:summary="@string/qs_neon_transparency_summary"
            android:defaultValue="78" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%" />
    </PreferenceCategory>
</PreferenceScreen>
