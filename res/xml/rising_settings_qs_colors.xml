<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:lineage="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/qs_colors_screen_title">

    <com.android.settingslib.widget.IllustrationPreference
        android:key="lottie_qs_color_style"
        lineage:lottie_rawRes="@raw/lottie_qs_color_style" />

    <PreferenceCategory android:title="@string/qs_backdrop_category">
        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="qs_background_transparency"
            android:title="@string/qs_background_transparency_title"
            android:summary="@string/qs_background_transparency_summary"
            android:defaultValue="0" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%"
            lineage:position="top" />
        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="qs_backdrop_blur_strength"
            android:title="@string/qs_backdrop_blur_title"
            android:summary="@string/qs_backdrop_blur_summary"
            android:defaultValue="100" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%"
            lineage:position="bottom" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/qs_tile_background_colors_title">

        <com.android.settings.preferences.SystemSettingListPreference
            android:key="qs_tile_shape"
            android:title="@string/qs_tile_shape_title"
            android:entries="@array/qs_tile_shape_entries"
            android:entryValues="@array/qs_tile_shape_values"
            android:defaultValue="0"
            android:summary="%s"
            lineage:position="top" />

        <com.android.settings.preferences.SystemSettingListPreference
            android:key="qs_active_background_effect"
            android:title="@string/qs_active_background_effect_title"
            android:entries="@array/qs_tile_effect_entries"
            android:entryValues="@array/qs_tile_effect_values"
            android:defaultValue="0"
            android:summary="%s" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="qs_active_glow_intensity"
            android:title="@string/neon_glow_intensity_title"
            android:defaultValue="60"
            android:max="100"
            settings:min="0"
            settings:interval="1"
            settings:units="%" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="qs_active_neon_transparency"
            android:title="@string/qs_neon_transparency_title"
            android:summary="@string/qs_neon_transparency_summary"
            android:defaultValue="78" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="qs_active_frosted_glass_tint"
            android:title="@string/qs_glass_tint_intensity_title"
            android:summary="@string/qs_glass_tint_intensity_summary"
            android:defaultValue="35" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="qs_active_frosted_glass_softness"
            android:title="@string/qs_glass_softness_title"
            android:summary="@string/qs_glass_softness_summary"
            android:defaultValue="60" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="qs_active_frosted_glass_transparency"
            android:title="@string/qs_glass_transparency_title"
            android:summary="@string/qs_glass_transparency_summary"
            android:defaultValue="0" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="qs_active_liquid_glass_tint"
            android:title="@string/qs_glass_tint_intensity_title"
            android:summary="@string/qs_glass_tint_intensity_summary"
            android:defaultValue="35" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="qs_active_liquid_glass_softness"
            android:title="@string/qs_glass_softness_title"
            android:summary="@string/qs_glass_softness_summary"
            android:defaultValue="20" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="qs_active_liquid_glass_transparency"
            android:title="@string/qs_glass_transparency_title"
            android:summary="@string/qs_glass_transparency_summary"
            android:defaultValue="0" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%" />

        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="qs_active_background_color"
            android:title="@string/qs_active_background_first_title"
            android:defaultValue="0xff6200ee" />

        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="qs_active_gradient_end_color"
            android:title="@string/qs_active_background_second_title"
            android:defaultValue="0xff0000ff" />

        <com.android.settings.preferences.SystemSettingListPreference
            android:key="qs_inactive_background_effect"
            android:title="@string/qs_inactive_background_effect_title"
            android:entries="@array/qs_tile_effect_entries"
            android:entryValues="@array/qs_tile_effect_values"
            android:defaultValue="0"
            android:summary="%s" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="qs_inactive_glow_intensity"
            android:title="@string/neon_glow_intensity_title"
            android:defaultValue="60"
            android:max="100"
            settings:min="0"
            settings:interval="1"
            settings:units="%" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="qs_inactive_neon_transparency"
            android:title="@string/qs_neon_transparency_title"
            android:summary="@string/qs_neon_transparency_summary"
            android:defaultValue="78" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="qs_inactive_frosted_glass_tint"
            android:title="@string/qs_glass_tint_intensity_title"
            android:summary="@string/qs_glass_tint_intensity_summary"
            android:defaultValue="20" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="qs_inactive_frosted_glass_softness"
            android:title="@string/qs_glass_softness_title"
            android:summary="@string/qs_glass_softness_summary"
            android:defaultValue="60" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="qs_inactive_frosted_glass_transparency"
            android:title="@string/qs_glass_transparency_title"
            android:summary="@string/qs_glass_transparency_summary"
            android:defaultValue="0" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="qs_inactive_liquid_glass_tint"
            android:title="@string/qs_glass_tint_intensity_title"
            android:summary="@string/qs_glass_tint_intensity_summary"
            android:defaultValue="20" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="qs_inactive_liquid_glass_softness"
            android:title="@string/qs_glass_softness_title"
            android:summary="@string/qs_glass_softness_summary"
            android:defaultValue="20" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="qs_inactive_liquid_glass_transparency"
            android:title="@string/qs_glass_transparency_title"
            android:summary="@string/qs_glass_transparency_summary"
            android:defaultValue="0" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%" />

        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="qs_inactive_background_color"
            android:title="@string/qs_inactive_background_title"
            android:defaultValue="0xff55555f" />

        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="qs_inactive_gradient_end_color"
            android:title="@string/qs_inactive_background_second_title"
            android:defaultValue="0xff0000ff"
            lineage:position="bottom" />
    </PreferenceCategory>

    <PreferenceCategory android:title="@string/qs_brightness_appearance_title">
        <ListPreference
            android:key="qs_brightness_color_effect"
            android:title="@string/qs_brightness_style_title"
            android:entries="@array/qs_brightness_effect_entries"
            android:entryValues="@array/qs_brightness_effect_values"
            android:defaultValue="0" android:summary="%s" android:persistent="false" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="qs_brightness_glow_intensity"
            android:title="@string/neon_glow_intensity_title"
            android:defaultValue="60" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="qs_brightness_neon_transparency"
            android:title="@string/qs_neon_transparency_title"
            android:summary="@string/qs_neon_transparency_summary"
            android:defaultValue="78" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%" />
        <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="qs_brightness_color_enabled"
            android:title="@string/qs_brightness_color_enabled_title"
            android:defaultValue="false" />

        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="qs_brightness_color"
            android:title="@string/qs_brightness_color_first_title"
            android:defaultValue="0xff6200ee" />

        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="qs_brightness_gradient_end_color"
            android:title="@string/qs_brightness_color_second_title"
            android:defaultValue="0xff0000ff" />

        <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="qs_brightness_track_color_enabled"
            android:title="@string/qs_brightness_track_enabled_title"
            android:defaultValue="false" />

        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="qs_brightness_track_color"
            android:title="@string/qs_brightness_track_title"
            android:defaultValue="0xff0000ff"
            android:dependency="qs_brightness_track_color_enabled"
            lineage:position="bottom" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/qs_icon_colors_title">

        <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="qs_active_icon_color_enabled"
            android:title="@string/qs_active_icon_color_enabled_title"
            android:summary="@string/qs_icon_color_enabled_summary"
            android:defaultValue="false"
            lineage:position="top" />

        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="qs_active_icon_color"
            android:title="@string/qs_active_icon_color_title"
            android:defaultValue="0xffffffff"
            android:dependency="qs_active_icon_color_enabled" />

        <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="qs_inactive_icon_color_enabled"
            android:title="@string/qs_inactive_icon_color_enabled_title"
            android:summary="@string/qs_icon_color_enabled_summary"
            android:defaultValue="false" />

        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="qs_inactive_icon_color"
            android:title="@string/qs_inactive_icon_color_title"
            android:defaultValue="0xffffffff"
            android:dependency="qs_inactive_icon_color_enabled"
            lineage:position="bottom" />
    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/qs_label_colors_title">

        <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="qs_active_label_color_enabled"
            android:title="@string/qs_active_label_color_enabled_title"
            android:summary="@string/qs_label_color_enabled_summary"
            android:defaultValue="false"
            lineage:position="top" />

        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="qs_active_label_color"
            android:title="@string/qs_active_label_color_title"
            android:defaultValue="0xff000000"
            android:dependency="qs_active_label_color_enabled" />

        <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="qs_inactive_label_color_enabled"
            android:title="@string/qs_inactive_label_color_enabled_title"
            android:summary="@string/qs_label_color_enabled_summary"
            android:defaultValue="false" />

        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="qs_inactive_label_color"
            android:title="@string/qs_inactive_label_color_title"
            android:defaultValue="0xffffffff"
            android:dependency="qs_inactive_label_color_enabled" />

        <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="qs_active_secondary_label_color_enabled"
            android:title="@string/qs_active_secondary_label_color_enabled_title"
            android:summary="@string/qs_label_color_enabled_summary"
            android:defaultValue="false" />

        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="qs_active_secondary_label_color"
            android:title="@string/qs_active_secondary_label_color_title"
            android:defaultValue="0xff000000"
            android:dependency="qs_active_secondary_label_color_enabled" />

        <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="qs_inactive_secondary_label_color_enabled"
            android:title="@string/qs_inactive_secondary_label_color_enabled_title"
            android:summary="@string/qs_label_color_enabled_summary"
            android:defaultValue="false" />

        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="qs_inactive_secondary_label_color"
            android:title="@string/qs_inactive_secondary_label_color_title"
            android:defaultValue="0xffffffff"
            android:dependency="qs_inactive_secondary_label_color_enabled"
            lineage:position="bottom" />
    </PreferenceCategory>



    <PreferenceCategory android:title="@string/qs_header_colors_title">
        <com.android.settings.preferences.SystemSettingSwitchPreference
             android:key="qs_header_clock_color_enabled"
             android:title="@string/qs_header_clock_color_enabled_title"
             android:summary="@string/qs_label_color_enabled_summary"
             android:defaultValue="false" />

        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
             android:key="qs_header_clock_color"
             android:title="@string/qs_header_clock_color_title"
             android:defaultValue="0xffffffff"
             android:dependency="qs_header_clock_color_enabled" />

        <com.android.settings.preferences.SystemSettingSwitchPreference
             android:key="qs_header_date_color_enabled"
             android:title="@string/qs_header_date_color_enabled_title"
             android:summary="@string/qs_label_color_enabled_summary"
             android:defaultValue="false" />

        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
             android:key="qs_header_date_color"
             android:title="@string/qs_header_date_color_title"
             android:defaultValue="0xffffffff"
             android:dependency="qs_header_date_color_enabled"
             lineage:position="bottom" />

    </PreferenceCategory>
</PreferenceScreen>
