<PreferenceScreen
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:lineage="http://schemas.android.com/apk/res-auto"
    xmlns:settings="http://schemas.android.com/apk/res/com.android.settings"
    android:title="@string/lockscreen_title">

    <com.android.settings.preferences.rainbow.RainbowPreferenceCategory
        android:key="highlights"
        android:title="@string/highlights_title">

        <com.android.settingslib.widget.LayoutPreference
            android:key="lockscreen_highlight_dashboard"
            android:layout="@layout/lockscreen_highlight_dashboard"
            android:selectable="false"/>

    </com.android.settings.preferences.rainbow.RainbowPreferenceCategory>

    <PreferenceCategory
        android:key="lockscreen_interface_category"
        android:title="@string/lockscreen_interface_category">


        <com.android.settings.preferences.ui.AdaptivePreference
            android:key="credential_colors"
            android:title="@string/credential_colors_title"
            android:summary="@string/credential_colors_summary"
            android:fragment="com.rising.settings.fragments.CredentialColors" />

        <com.android.settings.preferences.ui.AdaptivePreference
            android:key="lock_glymps_settings"
            android:title="@string/lock_glymps_title"
            android:summary="@string/lock_glymps_enable_summary"
            android:fragment="com.rising.settings.fragments.LockGlympsSettings"
            lineage:position="top" />

        <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="lockscreen_battery_info"
            android:title="@string/lockscreen_battery_info_title"
            android:summary="@string/lockscreen_battery_info_summary"
            android:defaultValue="true" />

        <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="lockscreen_charging_time"
            android:title="@string/lock_screen_charging_time_title"
            android:summary="@string/lock_screen_charging_time_summary"
            android:defaultValue="true" />

        <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="hide_lockscreen_status_bar"
            android:title="@string/hide_lockscreen_status_bar_title"
            android:summary="@string/hide_lockscreen_status_bar_summary"
            android:defaultValue="false" />

        <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="lockscreen_show_carrier"
            android:title="@string/lockscreen_show_carrier_title"
            android:summary="@string/lockscreen_show_carrier_summary"
            android:defaultValue="true"
            />

        <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="ls_media_art_enabled"
            android:title="@string/media_art_title"
            android:summary="@string/media_art_summary"
            android:defaultValue="false" />

        <com.android.settings.preferences.SystemSettingListPreference
            android:key="ls_media_art_filter"
            android:title="@string/lockscreen_albumart_filter_title"
            android:entries="@array/lockscreen_albumart_filter_entries"
            android:entryValues="@array/lockscreen_albumart_filter_values"
            android:dependency="ls_media_art_enabled"
            android:defaultValue="0" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="ls_media_art_fade_level"
            android:title="@string/ls_media_art_fade_level_title"
            android:summary="@string/ls_media_art_fade_level_summary"
            android:defaultValue="40"
            settings:interval="1"
            settings:units="%"
            android:max="100"
            android:min="0"
            android:dependency="ls_media_art_enabled"
            lineage:position="bottom" />

    </PreferenceCategory>

    <PreferenceCategory
        android:title="@string/rising_stacks_title">

        <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="rising_stacks_enabled"
            android:title="@string/rising_stacks_title"
            android:summary="@string/rising_stacks_summary"
            android:defaultValue="false"
            lineage:position="top" />

        <ListPreference
            android:key="rising_stacks_icon_pack_picker"
            android:title="@string/rising_stacks_icon_pack_title"
            android:summary="@string/rising_stacks_icon_pack_summary"
            android:dependency="rising_stacks_enabled"
            android:persistent="false" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="rising_stacks_icon_size"
            android:title="@string/rising_stacks_icon_size"
            android:summary="@string/rising_stacks_icon_size_summary"
            android:defaultValue="30" android:max="60" settings:min="24"
            settings:interval="2" settings:units=" dp"
            android:dependency="rising_stacks_enabled" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="rising_stacks_icon_spacing"
            android:title="@string/rising_stacks_icon_spacing"
            android:summary="@string/rising_stacks_icon_spacing_summary"
            android:defaultValue="4" android:max="32" settings:min="0"
            settings:interval="1" settings:units=" dp"
            android:dependency="rising_stacks_enabled" />

        <com.android.settings.preferences.SystemSettingListPreference
            android:key="rising_stacks_effect" android:title="@string/rising_stacks_effect"
            android:entries="@array/credential_pin_effect_entries"
            android:entryValues="@array/credential_pin_effect_values"
            android:defaultValue="0" android:summary="%s"
            android:dependency="rising_stacks_enabled" />

        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="rising_stacks_first_color" android:title="@string/rising_stacks_first_color"
            android:defaultValue="0xffff0055" android:dependency="rising_stacks_enabled" />
        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="rising_stacks_second_color" android:title="@string/rising_stacks_second_color"
            android:defaultValue="0xff315bff" android:dependency="rising_stacks_enabled" />
        <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="rising_stacks_outline" android:title="@string/rising_stacks_outline"
            android:defaultValue="true" android:dependency="rising_stacks_enabled" />
        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="rising_stacks_glow_intensity" android:title="@string/rising_stacks_glow_intensity"
            android:defaultValue="60" android:max="100" settings:min="0" settings:interval="1"
            settings:units="%" android:dependency="rising_stacks_enabled" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="rising_stacks_neon_transparency"
            android:title="@string/qs_neon_transparency_title"
            android:summary="@string/qs_neon_transparency_summary"
            android:defaultValue="78" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%"
            android:dependency="rising_stacks_enabled" lineage:position="bottom" />
    </PreferenceCategory>

    <PreferenceCategory
        android:key="lockscreen_gestures_category"
        android:title="@string/gestures_title">

        <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="double_tap_sleep_lockscreen"
            android:title="@string/lockscreen_doubletap_sleep_title"
            android:summary="@string/lockscreen_doubletap_sleep_summary"
            android:defaultValue="true"
            lineage:position="solo" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="lockscreen_fp_category"
        android:title="@string/lockscreen_fp_category_title">

        <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="fp_success_vibrate"
            android:title="@string/fp_success_vibrate_title"
            android:summary="@string/fp_success_vibrate_summary"
            android:defaultValue="true" 
            lineage:position="top"/>

        <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="fp_error_vibrate"
            android:title="@string/fp_error_vibrate_title"
            android:summary="@string/fp_error_vibrate_summary"
            android:defaultValue="true" />

        <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="enable_ripple_effect"
            android:title="@string/enable_fingerprint_ripple_effect_title"
            android:summary="@string/enable_fingerprint_ripple_effect_summary"
            android:defaultValue="true"
            lineage:position="bottom" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="lockscreen_udfps_category"
        android:title="@string/udfps_settings_title">
        
        <com.android.settings.preferences.ui.AdaptivePreference
            android:key="udfps_icon_picker"
            android:title="@string/udfps_icon_picker_title"
            android:summary="@string/udfps_icon_picker_summary"
            android:fragment="com.rising.settings.fragments.lockscreen.UdfpsIconPicker"
            lineage:position="top" />

        <com.android.settings.preferences.ui.AdaptivePreference
            android:key="udfps_recognizing_animation_preview"
            android:title="@string/udfps_recog_animation_effect_title"
            android:summary="@string/udfps_recog_animation_effect_summary"
            android:fragment="com.rising.settings.fragments.lockscreen.UdfpsAnimation"  />

        <com.android.settings.preferences.SecureSettingSwitchPreference
            android:key="screen_off_udfps_enabled"
            android:title="@string/screen_off_udfps_title"
            android:summary="@string/screen_off_udfps_summary"
            android:defaultValue="false"
            lineage:position="bottom" />

    </PreferenceCategory>
    
    <PreferenceCategory
        android:key="lockscreen_misc_category"
        android:title="@string/misc_title">

        <!-- Ambient Wallpaper -->
        <com.android.settings.preferences.SecureSettingSwitchPreference
            android:key="doze_always_on_wallpaper_enabled"
            android:title="@string/doze_always_on_wallpaper_title"
            android:summary="@string/doze_always_on_wallpaper_summary"
            android:defaultValue="@*android:bool/config_dozeSupportsAodWallpaper"
            lineage:position="top" />

        <!-- Face unlock animation -->
        <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="face_unlock_animation"
            android:title="@string/face_unlock_animation_title"
            android:summary="@string/face_unlock_animation_summary"
            android:defaultValue="true" />

        <!-- Dynamic charging animation -->
        <com.android.settings.preferences.SystemSettingSwitchPreference
            android:key="wireless_charging_dynamic_color"
            android:title="@string/wireless_charging_dynamic_color_title"
            android:summary="@string/wireless_charging_dynamic_color_summary"
            android:defaultValue="true" />

    </PreferenceCategory>

    <PreferenceCategory android:title="@string/power_menu_options_title">
        <com.android.settings.preferences.SystemSettingSwitchPreference
               android:key="lockscreen_enable_power_menu"
               android:title="@string/lockscreen_enable_power_menu_title"
               android:summary="@string/lockscreen_enable_power_menu_summary"
               android:defaultValue="true"
               lineage:position="top" />

        <com.android.settings.preferences.SecureSettingSwitchPreference
            android:key="global_actions_use_compose_dialog"
            android:title="@string/global_actions_use_compose_dialog_title"
            android:summary="@string/global_actions_use_compose_dialog_summary"
            android:defaultValue="true" />

        <com.android.settings.preferences.SecureSettingSwitchPreference
            android:key="advanced_reboot"
            android:title="@string/global_actions_advanced_reboot_title"
            android:summary="@string/global_actions_advanced_reboot_summary"
            android:defaultValue="true"
            android:dependency="global_actions_use_compose_dialog"
            />


        <com.android.settings.preferences.SystemSettingListPreference
            android:key="power_menu_tile_style"
            android:title="@string/power_menu_tile_style_title"
            android:entries="@array/qs_compose_tile_style_entries"
            android:entryValues="@array/qs_compose_tile_style_values"
            android:defaultValue="0"
            android:summary="%s"
            android:dependency="global_actions_use_compose_dialog" />

        <com.android.settings.preferences.SystemSettingListPreference
            android:key="power_menu_tile_color_effect"
            android:title="@string/power_menu_color_effect_title"
            android:entries="@array/power_menu_color_effect_entries"
            android:entryValues="@array/power_menu_color_effect_values"
            android:defaultValue="0"
            android:summary="%s"
            android:dependency="global_actions_use_compose_dialog" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="power_menu_glow_intensity"
            android:title="@string/neon_glow_intensity_title"
            android:defaultValue="60"
            android:max="100"
            settings:min="0"
            settings:interval="1"
            settings:units="%"
            android:dependency="global_actions_use_compose_dialog" />

        <com.android.settings.preferences.SystemSettingSeekBarPreference
            android:key="power_menu_neon_transparency"
            android:title="@string/qs_neon_transparency_title"
            android:summary="@string/qs_neon_transparency_summary"
            android:defaultValue="78" android:max="100"
            settings:min="0" settings:interval="1" settings:units="%" />

        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="power_menu_tile_color_first"
            android:title="@string/power_menu_color_first_title"
            android:defaultValue="0xff6200ee"
            android:dependency="global_actions_use_compose_dialog" />

        <com.android.settings.preferences.colorpicker.SystemSettingColorPickerPreference
            android:key="power_menu_tile_color_second"
            android:title="@string/power_menu_color_second_title"
            android:defaultValue="0xff0000ff"
            android:dependency="global_actions_use_compose_dialog"
            lineage:position="bottom" />

    </PreferenceCategory>

</PreferenceScreen>
